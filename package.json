{
    "name": "questcraft",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "AI-powered educational board game engine. Play pre-made quests or create your own.",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test:prompts": "node services/promptTester.js",
        "test:prompts:all": "npm run test:prompts && npm run test:prompts:all",
        "lint": "eslint . --ext .ts,.tsx,.js",
        "lint:fix": "eslint . --ext .ts,.tsx,.js --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "dependencies": {
        "@google/genai": "^1.13.0",
        "@testing-library/dom": "^10.4.1",
        "dompurify": "^3.4.14",
        "openai": "^5.12.2",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "showdown": "2.1.0",
        "zod": "^4.5.1"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.6",
        "@types/node": "^22.14.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.6",
        "typescript": "~5.8.2",
        "vite": "^7.1.2",
        "vite-plugin-static-copy": "^3.1.1",
        "vitest": "^4.1.11"
    }
}
